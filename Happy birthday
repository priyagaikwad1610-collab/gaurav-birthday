
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Gaurav ❤️</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  overflow-x: hidden;
  font-family: 'Trebuchet MS', sans-serif;
  color: white;
  text-align: center;
  background: radial-gradient(circle at top, #52216d, #13051f 75%);
}

.scene {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px 15px;
  perspective: 1000px;
}

.card {
  width: 100%;
  max-width: 430px;
  padding: 30px 20px;
  border: 1px solid #ffffff50;
  border-radius: 28px;
  background: linear-gradient(145deg,
  #ffffff20, #ffffff08);
  backdrop-filter: blur(15px);
  box-shadow: 0 20px 60px #0008,
              0 0 30px #d77aff40;
  transform-style: preserve-3d;
  animation: entrance 1.5s ease;
  z-index: 2;
}

@keyframes entrance {
  from { opacity: 0; transform: rotateX(15deg) translateY(60px); }
  to { opacity: 1; transform: rotateX(0) translateY(0); }
}

h1 {
  font-size: 35px;
  color: #ffe0f0;
  text-shadow: 0 0 20px #ff80bf;
}

.name {
  font-size: 42px;
  color: #ffd1e8;
  margin-top: 10px;
  letter-spacing: 3px;
  text-shadow: 0 0 25px #ff65ad;
}

.subtitle {
  margin: 15px 0;
  color: #f9d9ff;
  line-height: 1.7;
}

/* 3D Cake */

.cake-area {
  height: 210px;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 600px;
}

.cake {
  position: relative;
  width: 180px;
  height: 110px;
  transform-style: preserve-3d;
  animation: cakeFloat 3s ease-in-out infinite;
}

@keyframes cakeFloat {
  50% { transform: translateY(-12px) rotateY(8deg); }
}

.layer {
  position: absolute;
  left: 0;
  width: 180px;
  height: 65px;
  border-radius: 12px 12px 18px 18px;
  background: linear-gradient(90deg,
  #9d174d, #ff78b7, #d9468b);
  box-shadow: inset -10px 0 15px #6b1745;
}

.bottom { bottom: 0; }
.top {
  bottom: 48px;
  width: 145px;
  left: 17px;
  height: 50px;
  background: linear-gradient(90deg,
  #ffb3d5, #fff0f7, #ff82bd);
}

.icing {
  position: absolute;
  width: 180px;
  height: 25px;
  bottom: 55px;
  border-radius: 50%;
  background: #fff0f7;
}

.candle {
  position: absolute;
  width: 9px;
  height: 45px;
  background: repeating-linear-gradient(
    45deg, white 0 5px, #ff5c9e 5px 10px
  );
  bottom: 105px;
  left: 85px;
  border-radius: 5px;
}

.flame {
  position: absolute;
  width: 17px;
  height: 25px;
  bottom: 148px;
  left: 81px;
  border-radius: 50% 50% 50% 50%;
  background: radial-gradient(#fff, #ffdc62, #ff7b00);
  box-shadow: 0 0 25px #ffdc62;
  animation: flicker .5s infinite alternate;
}

@keyframes flicker {
  to { transform: scale(.8) rotate(8deg); }
}

button {
  border: none;
  border-radius: 30px;
  padding: 15px 25px;
  margin-top: 15px;
  font-size: 16px;
  font-weight: bold;
  color: #75134d;
  background: linear-gradient(45deg,
  #fff0f7, #ff9bc9);
  box-shadow: 0 0 25px #ff79b9;
  cursor: pointer;
  transition: .3s;
}

button:hover {
  transform: scale(1.08);
  box-shadow: 0 0 35px #ffb0d7;
}

#letter {
  display: none;
  margin-top: 25px;
  padding: 20px;
  border-radius: 18px;
  background: #ffffff17;
  border: 1px solid #ffffff40;
  line-height: 1.9;
  animation: reveal 1.5s ease;
}

@keyframes reveal {
  from { opacity: 0; transform: translateY(30px) scale(.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

#letter h2 {
  color: #ffc2e0;
  margin-bottom: 12px;
}

.heart {
  position: fixed;
  bottom: -30px;
  color: #ff8bc5;
  pointer-events: none;
  animation: floatUp 6s linear forwards;
  z-index: 4;
}

@keyframes floatUp {
  to {
    transform: translateY(-110vh) rotate(360deg);
    opacity: 0;
  }
}

.stars {
  position: fixed;
  color: white;
  animation: sparkle 2s infinite alternate;
  pointer-events: none;
}

@keyframes sparkle {
  from { opacity: .2; transform: scale(.7); }
  to { opacity: 1; transform: scale(1.3); }
}

#fireworks {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}
</style>
</head>

<body>

<canvas id="fireworks"></canvas>

<div class="scene">
<div class="card">

<h1>✨ A Special Day ✨</h1>

<div class="name">GAURAV ❤️</div>

<p class="subtitle">
Today the universe has one more reason to celebrate...
Because someone truly special was born! 🌙
</p>

<div class="cake-area">
  <div class="cake">
    <div class="layer bottom"></div>
    <div class="layer top"></div>
    <div class="icing"></div>
    <div class="candle"></div>
    <div class="flame"></div>
  </div>
</div>

<h2>🎂 Happy Birthday! 🎂</h2>

<p class="subtitle">
Close your eyes, make a beautiful wish
and let this moment become magical.
</p>

<button onclick="celebrate()">
💖 Make A Wish 💖
</button>

<div id="letter">
<h2>Dear Gaurav ❤️</h2>

<p>
Some people enter our lives and make ordinary
moments feel special. You are one of those
people.
<br><br>
On your birthday, I wish you endless happiness,
success, peace and countless reasons to smile.
May every dream in your heart find its way
into reality.
<br><br>
Never stop being the wonderful person you are.
May life surprise you with beautiful moments
and give you everything your heart wishes for.
<br><br>
And no matter where life takes you,
I hope you always remember how special you are.
<br><br>
<strong>Happy Birthday, Gaurav! ❤️</strong>
<br>
May your smile always shine brighter than
all the stars in the sky. ✨
</p>

<h2>🎉 Lots of happiness to you! 🎉</h2>
</div>

</div>
</div>

<script>
function celebrate() {
  document.getElementById("letter").style.display = "block";
  document.querySelector("button").style.display = "none";

  // Floating hearts
  for(let i=0; i<50; i++) {
    setTimeout(() => {
      let heart = document.createElement("div");
      heart.className = "heart";
      heart.innerHTML = ["❤️","💖","💕","✨"][Math.floor(Math.random()*4)];
      heart.style.left = Math.random()*100 + "vw";
      heart.style.fontSize = (15+Math.random()*25) + "px";
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 6000);
    }, i*100);
  }

  // Fireworks
  let canvas = document.getElementById("fireworks");
  let ctx = canvas.getContext("2d");
  canvas.width = innerWidth;
  canvas.height = innerHeight;

  let particles = [];

  for(let i=0; i<220; i++) {
    let angle = Math.random()*Math.PI*2;
    let speed = Math.random()*6+2;
    particles.push({
      x: Math.random()*canvas.width,
      y: Math.random()*canvas.height*.6,
      vx: Math.cos(angle)*speed,
      vy: Math.sin(angle)*speed,
      life: 100,
      color: ["#ff80bf","#ffe066","#ffffff","#bd93f9"]
      [Math.floor(Math.random()*4)]
    });
  }

  function animate() {
    ctx.clearRect(0,0,canvas.width,canvas.height);

    particles.forEach(p => {
      if(p.life > 0) {
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.life/100;
        ctx.beginPath();
        ctx.arc(p.x,p.y,3,0,Math.PI*2);
        ctx.fill();
        p.x += p.vx;
        p.y += p.vy;
        p.vy += .04;
        p.life--;
      }
    });

    ctx.globalAlpha = 1;

    if(particles.some(p => p.life > 0)) {
      requestAnimationFrame(animate);
    }
  }

  animate();
}

for(let i=0; i<45; i++) {
  let star = document.createElement("div");
  star.className = "stars";
  star.innerHTML = "✦";
  star.style.left = Math.random()*100+"vw";
  star.style.top = Math.random()*100+"vh";
  star.style.fontSize = (10+Math.random()*15)+"px";
  document.body.appendChild(star);
}
</script>

</body>
</html>
